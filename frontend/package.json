{
  "name": "@dev-mainsequence/mainsequence-markets-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "api:generate": "openapi-typescript ../docs/contracts/mainsequencemarkets-openapi.json -o src/lib/api/generated.ts",
    "api:check": "node scripts/check-generated-api.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "VITE_API_BASE_URL=http://127.0.0.1:2030 VITE_COMMAND_CENTER_ORIGIN=http://127.0.0.1:3100 npm run build && playwright test"
  },
  "dependencies": {
    "@dev-mainsequence/command-center-sdk": "file:../../../../../code/MainSequenceClientSide/command-center-sdk/command-center-sdk",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
