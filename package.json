{
  "name": "@dev-mainsequence/mainsequence-markets-site",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "docs:api:generate": "node scripts/generate-api-docs.mjs",
    "docs:dev": "npm run docs:api:generate && docusaurus start documentation --host 127.0.0.1 --port 3011 --no-open",
    "build": "npm run build:app && npm run build:docs",
    "build:app": "npm run theme:audit && tsc --noEmit && vite build",
    "build:docs": "npm run docs:api:generate && docusaurus build documentation --out-dir ../dist/docs",
    "preview": "vite preview",
    "api:generate": "openapi-typescript docs/technical/contracts/mainsequencemarkets-openapi.json -o src/lib/api/generated.ts",
    "api:check": "node scripts/check-generated-api.mjs && node scripts/check-openapi-documentation.mjs",
    "theme:audit": "command-center-sdk theme audit --path src",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "VITE_API_BASE_URL=http://127.0.0.1:2030 VITE_COMMAND_CENTER_ORIGIN=http://127.0.0.1:3100 VITE_FASTAPI_RELEASE_UID=00000000-0000-4000-8000-000000000203 VITE_E2E_HOST=true npm run build && playwright test"
  },
  "dependencies": {
    "@dev-mainsequence/command-center-sdk": "file:vendor/dev-mainsequence-command-center-sdk-0.1.13.tgz",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@eslint/js": "^9.39.5",
    "@mdx-js/react": "3.1.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "docusaurus-plugin-openapi-docs": "5.1.3",
    "docusaurus-theme-openapi-docs": "5.1.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "^7.13.0",
    "prism-react-renderer": "2.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
