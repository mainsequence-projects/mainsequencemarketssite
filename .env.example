# Local direct development only. Embedded deployments use the delegated release below.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Main Sequence Markets FastAPI ResourceRelease used by the SDK iframe transport.
VITE_FASTAPI_RELEASE_UID=62c2c7a4-eb2a-471e-8837-7e02c3c8fc09
# Exact local/test host origin. The platform injects this reserved value in deployed static builds.
VITE_COMMAND_CENTER_ORIGIN=https://command-center.example.com
# Hosting response header override. Keep this an explicit allowlist.
EMBED_FRAME_ANCESTORS='self' https://command-center.example.com
